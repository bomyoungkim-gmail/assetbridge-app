# =============================================================================
# AssetBridge — variáveis de ambiente (TEMPLATE)
# =============================================================================
#
# Copie para `.env` e ajuste os valores:
#     cp .env.example .env
#
# COMO É CONSUMIDO:
#   - docker compose:  lê o `.env` da raiz automaticamente para interpolar
#                      ${VAR} no docker-compose.yml. Cada var abaixo tem um
#                      DEFAULT no compose (${VAR:-default}), então sem `.env`
#                      o stack sobe igual ao de hoje.
#   - uvicorn direto:  `uvicorn assetbridge.api:app --env-file .env`
#   - shell:           `export VAR=valor` (bash) / `$env:VAR="valor"` (PowerShell)
#
# IMPORTANTE: o app Python lê `os.environ` direto — NÃO carrega `.env` sozinho.
# Quem injeta é compose / uvicorn / shell. `.env` NUNCA é commitado (gitignored);
# só este `.env.example`. Mantenha as DUAS chaves de cada seção em sincronia.
#
# Princípio: toda integração externa DEGRADA GRACIOSO — var ausente nunca quebra
# o boot, cai num default seguro (descrito em cada seção).


# =============================================================================
# 1. BANCO DE DADOS  (backend — obrigatório em produção)
# =============================================================================
#
# POSTGRES_*  → consumidos pela IMAGEM postgres (serviço `db`) para criar o banco.
# DATABASE_URL → string de conexão que o APP usa (system of record do IUP, ADR-0001,
#                + checkpointer durável PostgresSaver). Dialeto: postgresql+psycopg://
#
# Os dois conjuntos se sobrepõem (user/senha/db) e DEVEM ser consistentes: troque
# a senha em POSTGRES_PASSWORD e reflita em DATABASE_URL. Em produção, NÃO use ab/ab.
#   - host "db" = nome do serviço Postgres na rede do compose; fora dele, use o
#     host real (ex.: localhost).

POSTGRES_USER=ab
POSTGRES_PASSWORD=ab
POSTGRES_DB=assetbridge
DATABASE_URL=postgresql+psycopg://ab:ab@db:5432/assetbridge


# =============================================================================
# 2. ENRIQUECIMENTO CVM  (backend — opcional)
# =============================================================================
#
# CACHE_DIR  → liga o conector oficial VIVO (CvmCriSource via CvmCriCache): baixa
#              o zip anual do informe mensal de CRI (dados abertos), cacheia em
#              disco e enriquece ativos por ISIN (rating, situação, classe...).
#              Use um diretório GRAVÁVEL e PERSISTENTE (volume `cvm_cache` no
#              compose) senão re-baixa a cada restart.
# TTL_DAYS   → idade máxima do cache antes de rebaixar o zip (CVM atualiza ~semanal).
#
# Default (CACHE_DIR ausente): _NullSource — sem enriquecimento, ZERO rede.
# (É por isso que os testes não precisam de internet: a var fica vazia neles.)

ASSETBRIDGE_CVM_CRI_CACHE_DIR=/var/cache/assetbridge/cvm
ASSETBRIDGE_CVM_CRI_TTL_DAYS=7


# =============================================================================
# 3. FRONTEND  (backoffice HITL — Next.js, ADR-0009)
# =============================================================================
#
# Duas URLs porque o Next fala com a API em dois contextos:
#   - SERVER-SIDE (Server Components, dentro da rede do compose):
#       ASSETBRIDGE_API_URL → host interno do compose (http://api:8000)
#   - BROWSER (fetch client-side, na máquina do usuário):
#       NEXT_PUBLIC_ASSETBRIDGE_API_URL → porta publicada no host (http://localhost:8001)

ASSETBRIDGE_API_URL=http://api:8000
NEXT_PUBLIC_ASSETBRIDGE_API_URL=http://localhost:8001


# =============================================================================
# 4. PORTAS PUBLICADAS NO HOST  (opcional — evitar conflito com o stack Oikos)
# =============================================================================
#
# Porta INTERNA é fixa (8000 API / 3000 frontend); só a porta do HOST varia.
# Defaults 8001/3001 porque 8000/3000 são do stack Oikos vizinho.

API_HOST_PORT=8001
FRONTEND_HOST_PORT=3001


# =============================================================================
# 5. EXTRAÇÃO FUZZY VIA LLM  (backend — opcional, DESLIGADO por default)
# =============================================================================
#
# MODEL  → GATE: setado (não-vazio) liga o `OllamaProposer` real no nó `extract`
#          do grafo (`_field_proposer`). Vazio → None → `extract` é passthrough
#          (só identidade já estruturada; ZERO rede — por isso os testes não
#          tocam Ollama). Modelo atual: qwen3:8b (por enquanto; alvo eventual
#          qwen3:14b em host com VRAM, ADR-0013/0014).
# BASE_URL → host do servidor Ollama (ChatOllama é só o cliente).
#
# Ollama é SERVIÇO à parte (não sobe nos testes nem no `up` normal). Para ligar:
#   1) docker compose --profile llm up            # sobe o serviço `ollama`
#   2) docker compose exec ollama ollama pull qwen3:8b
#   3) sete ASSETBRIDGE_OLLAMA_MODEL=qwen3:8b e reinicie o `api`
# Deferido na prática até haver amostra real de texto caótico não-BTG (ADR-0012);
# o wiring já está pronto.

ASSETBRIDGE_OLLAMA_BASE_URL=http://ollama:11434
ASSETBRIDGE_OLLAMA_MODEL=qwen3:8b   # setado = LLM ligado; vazio/comentado = desligado
